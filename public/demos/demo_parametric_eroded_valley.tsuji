            "x": 600,
            "y": 0
          },
          "params": {
            "domain": "point",
            "name1": "P",
            "type1": "auto",
            "formula1": "P + vec(0, 0, -0.2 + (0.8 + 6.5*(0.5 + 0.5*fbm(P/7.5, 6, 4))) * clamp((abs(P.y + 2.4*sin(P.x/2.2)) - 0.7) / 5.5, 0, 1)^1.3)"
