          "position": {
            "x": -200,
            "y": 40
          },
          "params": {
            "mode": "function",
            "formula": "clamp(2a, 0, 1) x − clamp(2(a − 1), 0, 1) x³/3! + clamp(2(a − 2), 0, 1) x^5/5! − clamp(2(a − 3), 0, 1) x^7/7! + clamp(2(a − 4), 0, 1) x^9/9! − clamp(2(a − 5), 0, 1) x^11/11! + clamp(2(a − 6), 0, 1) x^13/13!",
            "from": -7,
            "to": 7,
            "samples": 600,
            "yMin": -3,
            "yMax": 3,
            "progress": 1,
            "color": 15234107,
            "width": 3,
            "dashed": false,
            "visible": true,
            "a": 0
          }
        },
