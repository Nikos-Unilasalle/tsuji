        {
          "id": "tips",
          "type": "attribute/expression",
          "position": {
            "x": 3000,
            "y": -250
          },
          "params": {
            "group": "extrude_top",
            "domain": "face",
            "name1": "bud",
            "type1": "vec3",
            "formula1": "N"
          }
        },
        {
          "id": "bud_pts",
          "type": "attribute/promote",
          "position": {
            "x": 3000,
            "y": -450
          },
          "params": {
            "name": "bud",
            "from": "face",
            "to": "point",
            "reduce": "sum",
            "keep": false
          }
        },
        {
          "id": "front",
          "type": "attribute/expression",
          "position": {
            "x": 3000,
            "y": 0
          },
          "params": {
            "domain": "point",
            "name1": "glow",
            "type1": "float",
            "formula1": "clamp(4.5 * clamp((mod(0.11*t, 1.35) - geodesic) / 0.1, 0, 1) * (1 - clamp((mod(0.11*t, 1.35) - geodesic) / 0.1, 0, 1)) + 0.35 * clamp((mod(0.11*t, 1.35) - geodesic) / 0.1, 0, 1), 0, 1)",
            "name2": "P",
            "type2": "auto",
            "formula2": "P + bud * (0.55 * clamp((mod(0.11*t, 1.35) - geodesic - 0.05) / 0.2, 0, 1)) + N * (0.05 * clamp(4 * clamp((mod(0.11*t, 1.35) - geodesic) / 0.1, 0, 1) * (1 - clamp((mod(0.11*t, 1.35) - geodesic) / 0.1, 0, 1)), 0, 1))"
          }
        },
