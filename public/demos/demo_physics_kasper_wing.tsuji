          },
          "params": {
            "name": "Wing with Kasper notch",
            "mode": "parametric",
            "formula": "(1.9*v, (1.4*(1-0.5*v^2))*if(u>0,max((d*4*((1-cos(pi*u))/2)*(1-((1-cos(pi*u))/2)))+(c*(1+1.2*exp(-(v/0.12)^2))*5*(0.2969*sqrt(((1-cos(pi*u))/2))-0.126*((1-cos(pi*u))/2)-0.3516*((1-cos(pi*u))/2)^2+0.2843*((1-cos(pi*u))/2)^3-0.1036*((1-cos(pi*u))/2)^4))-(a*sqrt(sin(pi*clamp((((1-cos(pi*u))/2)-b)/0.4,0,1)))),(d*4*((1-cos(pi*u))/2)*(1-((1-cos(pi*u))/2)))-0.7*(c*(1+1.2*exp(-(v/0.12)^2))*5*(0.2969*sqrt(((1-cos(pi*u))/2))-0.126*((1-cos(pi*u))/2)-0.3516*((1-cos(pi*u))/2)^2+0.2843*((1-cos(pi*u))/2)^3-0.1036*((1-cos(pi*u))/2)^4))),(d*4*((1-cos(pi*u))/2)*(1-((1-cos(pi*u))/2)))-(c*(1+1.2*exp(-(v/0.12)^2))*5*(0.2969*sqrt(((1-cos(pi*u))/2))-0.126*((1-cos(pi*u))/2)-0.3516*((1-cos(pi*u))/2)^2+0.2843*((1-cos(pi*u))/2)^3-0.1036*((1-cos(pi*u))/2)^4)))+0.3*v^4, (-0.77+0.45*v^2)+((1-cos(pi*u))/2)*(1.4*(1-0.5*v^2)))",
            "uMin": -1,
            "uMax": 1,
            "vMin": -1,
            "vMax": 1,
            "resolution": 160,
            "zMin": -100,
            "zMax": 100,
            "colorLow": 8145438,
            "colorHigh": 14724195,
            "opacity": 1,
            "gridLines": 8,
            "gridColor": 3875856,
            "gridWidth": 1,
            "a": 0.22,
            "b": 0.45,
            "c": 0.26,
            "d": 0.05
          }
