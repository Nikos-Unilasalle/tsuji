            "pieceAttribute": "piece",
            "animated": false
          },
          "subgraph": {
            "nodes": [
              {
                "id": "gin",
                "type": "structure/group-input",
                "position": {
                  "x": 0,
                  "y": 0
                },
                "params": {
                  "ports": [
                    {
                      "id": "geometry",
                      "label": "Geometry",
                      "type": "geometry"
                    }
                  ]
                }
              },
              {
                "id": "info",
                "type": "structure/loop-info",
                "position": {
                  "x": 0,
                  "y": 250
                },
                "params": {}
              },
              {
                "id": "dist",
                "type": "math/expression",
                "position": {
                  "x": 300,
                  "y": 200
                },
                "params": {
                  "formula": "mod(x,4) == 0 ? 0.05 : mod(x,4) == 1 ? 0.07 : mod(x,4) == 2 ? 0.0 : 0.42"
                }
              },
              {
                "id": "scl",
                "type": "math/expression",
                "position": {
                  "x": 300,
                  "y": 350
                },
                "params": {
                  "formula": "mod(x,4) == 0 ? 1.12 : mod(x,4) == 2 ? 0.99/1.12 : 1"
                }
              },
              {
                "id": "rot",
                "type": "math/expression",
                "position": {
                  "x": 300,
                  "y": 500
                },
                "params": {
                  "formula": "(0, 0, mod(x,4) == 3 ? 0.075 : 0)"
                }
              },
              {
                "id": "ext",
                "type": "modifier/extrude",
                "position": {
                  "x": 600,
                  "y": 0
                },
                "params": {
                  "group": "extrude_top",
                  "distance": 0.3,
                  "passes": 1,
                  "scale": 1,
                  "selectMode": "all"
                }
              },
              {
                "id": "gout",
